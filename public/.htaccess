# Hostinger / LiteSpeed — site lives at /Teqnowebs (public_html/Teqnowebs)
DirectoryIndex index.html index.htm

Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /Teqnowebs/

  # Serve existing files and folders as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Map clean URLs to their index.html (Next.js trailingSlash export)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/ [R=301,L]

  # Fallback unknown paths to the static 404 page
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.html [L]
</IfModule>

AddType text/css .css
AddType application/javascript .js
AddType font/woff2 .woff2

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
