# Hostinger: unzip into public_html/ops/ OR subdomain document root.
# Do NOT nest another /public folder.

DirectoryIndex index.php

<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^(app|views|storage)/ - [F,L,NC]
  RewriteRule ^config(\.local)?\.php$ - [F,L,NC]
  RewriteRule ^\.env - [F,L,NC]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L]
</IfModule>
