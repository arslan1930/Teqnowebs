# Hostinger / LiteSpeed — site at domain root (public_html)
# URLs: https://mydomain.com/contact/  https://mydomain.com/about/  etc.
DirectoryIndex index.html index.htm

Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Old /Teqnowebs/... installs → domain-root paths
  RewriteRule ^[Tt]eqnowebs/?$ / [R=301,L]
  RewriteRule ^[Tt]eqnowebs/(.*)$ /$1 [R=301,L]

  # Capitalized page bookmarks → lowercase Next.js routes
  RewriteRule ^Contact/?$ /contact/ [R=301,L]
  RewriteRule ^About/?$ /about/ [R=301,L]
  RewriteRule ^Services/?$ /services/ [R=301,L]
  RewriteRule ^Software/?$ /software/ [R=301,L]
  RewriteRule ^Blog/?$ /blog/ [R=301,L]

  # Serve existing files and folders as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Map clean URLs to their index.html (Next.js trailingSlash export)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/ [R=301,L]

  # Fallback unknown paths to the static 404 page
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.html [L]
</IfModule>

AddType text/css .css
AddType application/javascript .js
AddType font/woff2 .woff2

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
