# Hostinger: unzip ALL of these files into public_html/ (domain root).
# index.php must sit directly in public_html/ — do NOT nest another /public folder.

DirectoryIndex index.php index.html

<IfModule mod_authz_core.c>
  # Allow the site (override accidental "deny all" from parent)
  Require all granted
</IfModule>

Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block direct web access to app internals
  RewriteRule ^(app|views|storage|scripts|sql)/ - [F,L,NC]
  RewriteRule ^config(\.local)?\.php$ - [F,L,NC]

  # Legacy Next path
  RewriteRule ^Teqnowebs/?(.*)$ /$1 [R=301,L,NC]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L]
</IfModule>
